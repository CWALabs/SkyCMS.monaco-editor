{
  "name": "@skycms/monaco-editor-integration",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SkyCMS Monaco Editor integration playground and deployment tooling.",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "mock:copilot": "node scripts/mock-copilot-server.mjs",
    "build": "vite build --config vite.config.mjs",
    "build:lib": "vite build --config vite.lib.config.mjs",
    "build:assets": "node scripts/package-monaco-assets.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "build:monaco": "cd ../../ && npm run build",
    "build:all": "vite build --config vite.lib.config.mjs && node scripts/package-monaco-assets.mjs && vite build --config vite.config.mjs",
    "build:all:with-upstream": "cd ../../ && npm run build && vite build --config vite.lib.config.mjs && node scripts/package-monaco-assets.mjs && vite build --config vite.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:skycms": "node scripts/deploy-skycms.mjs",
    "sync:status": "node scripts/upstream-sync-workflow.mjs status",
    "sync:upstream": "node scripts/upstream-sync-workflow.mjs sync-upstream",
    "sync:prepare": "node scripts/upstream-sync-workflow.mjs prepare-sync-branch",
    "sync:merge": "node scripts/upstream-sync-workflow.mjs merge-into-skycms",
    "sync:full": "node scripts/upstream-sync-workflow.mjs run-all",
    "sync:audit": "powershell -ExecutionPolicy Bypass -File scripts/upstream-sync-workflow.ps1 -Command run-all",
    "sync:audit:merge": "powershell -ExecutionPolicy Bypass -File scripts/upstream-sync-workflow.ps1 -Command run-all -Merge",
    "sync:audit:status": "powershell -ExecutionPolicy Bypass -File scripts/upstream-sync-workflow.ps1 -Command status"
  },
  "dependencies": {
    "emmet-monaco-es": "^5.7.0",
    "monaco-editor": "0.55.1",
    "monaco-themes": "^0.4.8",
    "monaco-vim": "^0.4.4"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.6"
  }
}
